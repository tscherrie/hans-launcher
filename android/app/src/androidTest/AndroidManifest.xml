<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:testOnly="true">
        <service android:name="ai.hans.standard.voice.tts.FixtureSystemSpeechEngine"
            android:exported="true" android:process=":system_speech_fixture">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.speech.tts" android:resource="@xml/system_speech_test_engine" />
        </service>
        <!--
             AndroidX first probes the target package and then falls back to the
             instrumentation package for createAndroidComposeRule<ComponentActivity>().
             Declare that fallback host explicitly so it works on every supported
             API level instead of relying on a transitive test manifest.
        -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="ai.hans.standard.setup.OrdinaryUidHandoffProbeActivity"
            android:exported="true" />
        <activity
            android:name="ai.hans.standard.diagnostics.OrdinaryUidMigrationDiagnosticsProbeActivity"
            android:exported="true" />
        <activity
            android:name="ai.hans.standard.fastphone.provisioning.OrdinaryUidFastPhoneProvisioningProbeActivity"
            android:exported="true" />
        <!-- A real foreign package/process/window for call-presentation tests, not a system app. -->
        <activity
            android:name="ai.hans.standard.ui.LiveCallForegroundBystanderActivity"
            android:exported="true"
            android:process=":call_bystander"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
